APP_ENV=local
SPRING_SERVER_PORT=8080
ML_GATEWAY_URL=http://localhost:8000

MONGODB_URI=mongodb://localhost:27017/cortexo

POSTGRES_URL=jdbc:postgresql://localhost:5432/cortexo_eval
POSTGRES_USER=cortexo
POSTGRES_PASSWORD=cortexo

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

MYSQL_ENABLED=false
MYSQL_URL=jdbc:mysql://localhost:3306/cortexo_mysql
MYSQL_USER=cortexo
MYSQL_PASSWORD=cortexo

SQLSERVER_ENABLED=false
SQLSERVER_URL=jdbc:sqlserver://localhost:1433;databaseName=cortexo;encrypt=false
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=ChangeThisStrongPassword123!

ORACLE_ENABLED=false
ORACLE_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
ORACLE_USER=app
ORACLE_PASSWORD=app

DB2_ENABLED=false
DB2_URL=jdbc:db2://localhost:50000/cortexo
DB2_USER=db2inst1
DB2_PASSWORD=ChangeThisStrongPassword123!

CASSANDRA_ENABLED=false
CASSANDRA_CONTACT_POINTS=localhost:9042
CASSANDRA_KEYSPACE=cortexo

JWT_SECRET=CHANGE_ME
JWT_EXPIRATION_MINUTES=120
FRONTEND_ORIGIN=http://localhost:5173

MODEL_ARTIFACT_ROOT=../../artifacts
DATASET_ROOT=../../datasets
REPO_WORKSPACE_ROOT=../../workspace
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=60
MAX_REPOSITORY_MB=100
MAX_PROMPT_TOKENS=8192

# Executable evaluation grader (must stay disabled until a sandbox image exists)
CORTEXO_GRADER_ENABLED=false
CORTEXO_SANDBOX_IMAGE=cortexo-sandbox:latest
# Optional override if the repo is not the default location (default: repo root)
# CORTEXO_REPO_ROOT=.